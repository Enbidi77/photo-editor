FROM node:22-alpine

# Install libc6-compat for compatibility with native packages and Next.js / Turbopack
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Install pnpm (matching package lockfile version)
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate || npm install -g pnpm@10

# Copy package definitions and lockfile
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./

# Install all dependencies (including devDependencies)
RUN pnpm install --frozen-lockfile

# Copy application source
COPY . .

# Copy and setup entrypoint script (normalize line endings for Windows host compatibility)
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh

# Set Next.js development environment defaults
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV WATCHPACK_POLLING=true

EXPOSE 3000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["pnpm", "dev"]
