# =====================================================================
# PixelForge — Docker Local Development Environment Configuration
# =====================================================================
# Copy this file to .env (or .env.local) if you wish to override defaults:
# cp .env.docker.example .env

# Web Application Port (host port forwarding)
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pixelforge
POSTGRES_PORT=5432

# Connection string when connecting to Docker Postgres from your host machine (e.g., local Drizzle Kit, DBeaver)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixelforge

# Automatically run Drizzle migrations on container startup (true/false)
AUTO_MIGRATE=true

# Drizzle Studio GUI Port (when started with --profile studio)
STUDIO_PORT=4983

# Supabase (Optional for local development)
# If omitted or left blank, PixelForge uses local IndexedDB storage and offline fallback mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
